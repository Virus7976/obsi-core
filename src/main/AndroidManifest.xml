<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    Each Obsi app guards its highlights with its own permission. Only apps signed with one of the
    Obsi keys get it (knownSigner, Android 12 and up). Each name is its own, because two apps
    with different keys may not define the same permission.
    -->
    <permission
        android:name="${applicationId}.permission.OBSI_SHARE"
        android:label="Share highlights between the Obsi apps"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/obsi_certs" />

    <uses-permission android:name="app.marginalia.permission.OBSI_SHARE" />
    <uses-permission android:name="app.obsiread.permission.OBSI_SHARE" />
    <uses-permission android:name="app.obsibible.permission.OBSI_SHARE" />
    <uses-permission android:name="app.obsilearn.permission.OBSI_SHARE" />

    <!-- Android 11 and up hides other apps unless they are named here. -->
    <queries>
        <package android:name="app.marginalia" />
        <package android:name="app.obsiread" />
        <package android:name="app.obsibible" />
        <package android:name="app.obsilearn" />
    </queries>

    <!-- Lending the phone's AI model to Obsidian needs a small notification while it is on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Read aloud keeps playing with the screen off, with controls on the lock screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!--
        The AI model bridge: answers apps the person linked, on 127.0.0.1 only. Not exported, so no
        other app can start or stop it.
        -->
        <service
            android:name="app.obsi.core.ai.ModelBridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Lets apps the user linked, like Obsidian, use the on-device AI model over 127.0.0.1." />
        </service>

        <!-- Asks the person before another app may use the model. -->
        <activity
            android:name="app.obsi.core.ui.ModelLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="obsi-ai" android:host="link" />
            </intent-filter>
        </activity>

        <!-- The phone's graphics chip runs an AI model much faster. Not every phone has these. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <provider
            android:name="app.obsi.core.share.SharedHighlightsProvider"
            android:authorities="${applicationId}.obsi"
            android:exported="true"
            android:readPermission="${applicationId}.permission.OBSI_SHARE" />

        <receiver
            android:name="app.obsi.core.widget.HighlightWidget"
            android:exported="false"
            android:label="@string/obsi_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obsi_widget_info" />
        </receiver>
    </application>
</manifest>
